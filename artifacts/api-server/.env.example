# =
#  The Girls Gurukul — Backend Environment Variables
#  TEMPLATE FILE — Copy this to .env and fill in real values
# =

# ── Gmail (Contact Form & Admissions Email) ──────────────────
# School Gmail address used to send emails
GMAIL_USER=

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=

# ── Groq API (AI Chatbot) ─────────────────────────────────────
# Get your free API key at: https://console.gxroq.com
GROQ_API_KEY=

# ── Cartesia API (Chatbot Voice / TTS) ───────────────────────
# Get your API key at: https://play.cartesia.ai
CARTESIA_API_KEY=

# ── Session Secret (Security) ─────────────────────────────────
# Any long random string — used to sign session cookies
# Generate one at: https://randomkeygen.com
SESSION_SECRET=

# ── Server Port (Do not change) ───────────────────────────────
PORT=
