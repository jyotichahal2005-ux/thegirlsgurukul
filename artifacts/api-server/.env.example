# ── Backend environment variables (set these in Render dashboard) ───────────

# Port — Render sets this automatically, do NOT set it manually
# PORT=8080

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app-name.vercel.app

# Groq API key (for the AI chatbot)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail address that sends/receives contact & admission emails
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your Gmail login password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Session secret (any long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Cartesia API key (for text-to-speech in the chatbot — optional)
CARTESIA_API_KEY=
